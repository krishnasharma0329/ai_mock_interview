# Which AI to use: groq (free tier) or claude
AI_PROVIDER=groq

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if AI_PROVIDER=claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000
CLAUDE_MODEL=claude-opus-5
# Thinking effort per stage: low | medium | high
EFFORT_RESEARCH=medium
EFFORT_TURN=medium
EFFORT_REPORT=medium
# Server-side refusal fallbacks (set 0 to disable)
USE_FALLBACKS=1
# Set to 1 to click through the UI without any AI calls
MOCK_AI=0
